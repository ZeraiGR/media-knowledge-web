{
 admin off
 auto_https off
}
:8080 {
 root * /srv
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  X-Robots-Tag "noindex, nofollow"
  Content-Security-Policy "default-src 'self'; connect-src 'self' https://storage.yandexcloud.net; media-src https://storage.yandexcloud.net; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'"
  -Server
 }
 handle /api/* {
  uri strip_prefix /api
  reverse_proxy api:8080
 }
 handle {
  try_files {path} /index.html
  file_server
 }
}
